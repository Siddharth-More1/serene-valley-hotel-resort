# Safe local-development template. Replace placeholders only in your local .env.
# Never put real secrets in this file or commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=

# Production security settings. HTTPS redirect defaults to true when DEBUG=false.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=300

# Optional local payment integration. Production requires all three values,
# using Razorpay Test Mode credentials only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional invoice/receipt branding.
HOTEL_NAME=Serene Valley Hotel & Resort
HOTEL_ADDRESS=
HOTEL_EMAIL=
HOTEL_CONTACT_PHONE=
HOTEL_GSTIN=

# Optional in development. Production requires a private S3-compatible bucket
# and bucket-scoped credentials. Leave blank locally; do not use real values here.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Optional local media directory override.
DJANGO_MEDIA_ROOT=
